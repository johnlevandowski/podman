# FileName=uptime-kuma.container
[Unit]
Description=Uptime Kuma Container

[Container]
Image=docker.io/louislam/uptime-kuma:2.5.11-slim
HostName=uptime-kuma
ReadOnly=true
AddCapability=NET_RAW

PublishPort=3001:3001

Volume=uptime-kuma-data:/app/data:z

[Service]
Restart=always

[Install]
WantedBy=default.target
