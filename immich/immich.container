# FileName=immich
[Unit]
Description=Immich
Requires=immich-redis.service immich-database.service
After=immich-redis.service immich-database.service

[Container]
Pod=immich.pod
Image=ghcr.io/immich-app/immich-server:v3.1.0
SecurityLabelDisable=true

Environment=TZ=US/Mountain
Environment=DB_USERNAME=postgres
Environment=DB_DATABASE_NAME=immich
Environment=DB_HOSTNAME=localhost
Environment=REDIS_HOSTNAME=localhost
Environment=CREDENTIALS_DIRECTORY=/run/secrets

Volume=/etc/localtime:/etc/localtime:ro
Volume=immich-data:/data
Volume=/share/lan/immich:/data/backups
Volume=/share/Pictures:/share/Pictures:ro

Secret=DB_PASSWORD

[Service]
Restart=always
